{
  "name": "ts-print-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @ondeoma/ts-print",
    "test": "npm run build && npm run build -w example && npm run test -w tests",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "prettier": "npm run prettier --workspaces",
    "prettier:fix": "npm run prettier:fix --workspaces",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.56.1"
  }
}
