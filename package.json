{
  "name": "ts-print-monorepo",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w ts-print",
    "test": "npm run build && npm run build -w example && npm run test -w tests",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "prettier": "npm run prettier --workspaces",
    "prettier:fix": "npm run prettier:fix --workspaces"
  }
}
