{
  "name": "@ondeoma/ts-print",
  "version": "0.0.3",
  "description": "Print source files as a transformer.",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "shx cp ../../README.md . && shx cp ../../LICENSE .",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "prettier": "prettier src --check",
    "prettier:fix": "prettier src --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ondeoma/ts-print"
  },
  "author": "hyranno",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ondeoma/ts-print/issues"
  },
  "homepage": "https://github.com/Ondeoma/ts-print#readme",
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "shx": "^0.4.0"
  }
}
